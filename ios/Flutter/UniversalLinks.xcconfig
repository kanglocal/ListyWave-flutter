// Universal Links (Associated Domains) 스위치 (PLAN §2.1, §9, docs/deeplinks/README.md).
// 운영 도메인이 확정되기 전 (PLAN §11 Q2) 에는 꺼 둔다. entitlement 를 켜면 App ID 에
// Associated Domains capability 가 있는 provisioning profile 이 있어야 서명된다.
//
// 켜는 방법: 아래 한 줄을 YES 로 바꾼다. host 는 flavor xcconfig 의 UNIVERSAL_LINK_HOST 다.
// 켜기 전에 웹에 apple-app-site-association 이 배포되어 있어야 한다 (docs/deeplinks/).
UNIVERSAL_LINKS_ENABLED=NO

UNIVERSAL_LINKS_ENTITLEMENTS_YES=Runner/Runner.entitlements
UNIVERSAL_LINKS_ENTITLEMENTS_NO=
CODE_SIGN_ENTITLEMENTS=$(UNIVERSAL_LINKS_ENTITLEMENTS_$(UNIVERSAL_LINKS_ENABLED))

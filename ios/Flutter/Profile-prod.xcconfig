// CocoaPods 가 이 configuration 용으로 만든 xcconfig 를 쓴다 (Podfile 의 project 매핑).
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.profile-prod.xcconfig"
#include "Generated.xcconfig"

// flavor: prod (PLAN §5.4)
FLAVOR_BUNDLE_SUFFIX=
APP_DISPLAY_NAME=ListyWave

// Universal Links host = env/prod.json SITE_URL 의 host. 켜는 스위치는 UniversalLinks.xcconfig.
UNIVERSAL_LINK_HOST=listywave.vercel.app
#include "UniversalLinks.xcconfig"
